rules_version = '2';

// Every upload goes through the Admin SDK in a trusted server context, after
// the server has checked the session, the store membership and the file:
// no client ever writes to Storage directly.
//
// Reads through the Firebase SDK or endpoint follow the same split as the
// objects' own public flag (services/storage):
// - catalog and store product images, and store logos, are public, since
//   the storefront shows them;
// - seller application files stay private until approval: only the
//   admin-only route /admin/sellers/applications/[id]/logo serves them.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /catalog/{allPaths=**} {
      allow read: if true;
    }

    match /sellers/{sellerId}/products/{fileName} {
      allow read: if true;
    }

    match /sellers/{sellerId}/logo/{fileName} {
      allow read: if true;
    }
  }
}
